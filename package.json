{
  "name": "music-loader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Учебное Chrome MV3 расширение с демонстрационной очередью загрузок",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "rsbuild dev --environment popup",
    "dev:extension": "rsbuild build --watch --mode development --env-mode development",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "rsbuild build && npm run validate:extension",
    "validate:extension": "node scripts/validate-extension.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "2.3.0",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-sass": "2.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
